{
  "manifest_version": 3,
  "name": "x1080x-ex｜98堂 TXT 附件自动命名",
  "version": "1.0.0",
  "description": "保留 98堂 原生附件下载，仅在 Chrome 确定保存文件名时应用帖子标题。",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://sehuatang.org/*",
    "https://www.sehuatang.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sehuatang.org/*",
        "https://www.sehuatang.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
